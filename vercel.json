{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    { "src": "/", "dest": "/index.html" },
    { "src": "/monitor", "dest": "/monitor.html" },
    { "src": "/owner", "dest": "/owner.html" },
    { "src": "/test-monitor", "dest": "/test-monitor.html" }
  ]
}