{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "css/*",
      "use": "@vercel/static"
    },
    {
      "src": "javascript/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/monitor", "dest": "/monitor.html" },
    { "src": "/owner", "dest": "/owner.html" },
    { "src": "/test-monitor", "dest": "/test-monitor.html" },
    { "src": "/api", "dest": "/api/index.js" }
  ]
}
